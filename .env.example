# =============================================================================
# Yaqeen AI — environment placeholders
# Copy to .env (and apps/web/.env.local as needed). Never commit real secrets.
# =============================================================================

# Application
APP_ENV=development
# Comma-separated origins allowed by the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Backend
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Supabase
# Frontend may use URL + anon key only. Service role must stay server-side.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend / privileged jobs only — never expose to the browser
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=payment-screenshots

# -----------------------------------------------------------------------------
# AI / vision provider (placeholder — wire in later; no live calls in scaffold)
# -----------------------------------------------------------------------------
AI_VISION_PROVIDER=openai
AI_VISION_API_KEY=
AI_VISION_MODEL=

# -----------------------------------------------------------------------------
# WhatsApp Cloud API webhook
# -----------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=replace-with-verify-token
WHATSAPP_APP_SECRET=replace-with-app-secret
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
